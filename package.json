{
  "name": "crm-whatsapp-base",
  "version": "0.1.0",
  "private": true,
  "description": "Base de CRM com WhatsApp (uazapi v2) + pipeline + IA opcional. Single-tenant, sem regra de negócio de nicho.",
  "scripts": {
    "dev": "tsx watch server.ts",
    "connect:cloud": "tsx scripts/connect-cloud-api.ts",
    "build": "next build",
    "start": "tsx server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "cf:clean": "node -e \"fs.rmSync('.next',{recursive:true,force:true});fs.rmSync('.open-next',{recursive:true,force:true})\" -r fs",
    "cf:build": "npm run cf:clean && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "tunnel": "npx cloudflared tunnel --url http://localhost:9876",
    "db:schema": "tsx scripts/ensure-schema.ts",
    "db:migrate:schema": "tsx scripts/migrate-schema.ts",
    "db:role": "tsx scripts/ensure-client-role.ts",
    "smoke": "tsx scripts/smoke.ts",
    "db:index": "tsx scripts/create-messages-index.ts",
    "cliente:novo": "tsx scripts/provisionar-cliente.ts",
    "usuario:rotacionar": "tsx scripts/rotacionar-usuario.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.7",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.4",
    "better-auth": "^1.2.0",
    "bullmq": "^5.27.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.487.0",
    "mime-types": "^3.0.2",
    "next": "^15.3.0",
    "openai": "^6.35.0",
    "pino": "^9.6.0",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.2",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.5.14",
    "@vitest/ui": "^4.1.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.4",
    "ioredis-mock": "^8.13.1",
    "msw": "^2.14.2",
    "pino-pretty": "^13.0.0",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.115.0"
  }
}
