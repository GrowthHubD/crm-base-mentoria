# ============================================================
# CRM WhatsApp — Variáveis de Ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# ============================================================

# --- App ---
NODE_ENV=development
PORT=9876
NEXTAUTH_URL=http://localhost:9876
NEXT_PUBLIC_AUTH_URL=http://localhost:9876

# --- Identidade (white-label) ---
# Fonte única: src/lib/branding.ts. Trocar a marca de um deploy é só mudar
# estas variáveis — nenhum código muda.
NEXT_PUBLIC_APP_NAME=Lidy
NEXT_PUBLIC_APP_FULL_NAME=Lidy
NEXT_PUBLIC_APP_TAGLINE=CRM de atendimento no WhatsApp
NEXT_PUBLIC_APP_TAGLINE_SHORT=CRM de Atendimento
NEXT_PUBLIC_APP_DESCRIPTION=
# Segmento do cliente em uma palavra (ex: clínica, loja, imobiliária).
# Vazio = prompts de IA ficam genéricos. NÃO deixe o nicho de um cliente vazar
# pro produto.
APP_BUSINESS_SEGMENT=
APP_EMAIL_DOMAIN=crm.local
# Prefixo dos instance_id criados na uazapi (instâncias de clientes diferentes
# convivem no mesmo servidor).
UAZAPI_INSTANCE_PREFIX=crm

# --- Módulos vendidos à parte (plano) ---
# Fonte única: src/lib/plan.ts. Desligado = o item nem aparece na navegação,
# inclusive para o admin — ele é o dono e não deve ver porta de produto que
# não comprou. Ligar é decisão comercial, feita por instância.
FEATURE_AI_AGENT=false
FEATURE_SCHEDULING=false
FEATURE_QUICK_REPLIES=false
FEATURE_RANKING=true

# --- Banco de Dados (PostgreSQL — Neon, Supabase, local, etc.) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Redis (local via docker-compose ou Redis Cloud em prod) ---
# Sem Redis, o webhook processa inline (fallback) — bom pra dev.
REDIS_URL=redis://localhost:6379

# --- Better Auth ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# --- Criptografia (tokens sensíveis no DB) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ============================================================
# IA (opcional) — OpenRouter (chat completions)
# ============================================================
# Sem OPENROUTER_API_KEY o agente IA fica inativo (o CRM funciona 100% no manual).
# Conta em https://openrouter.ai → Keys → Create Key
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_ID=google/gemini-3-flash-preview
AI_MAX_TOKENS=1024
# Nome do negócio que a IA cita ao falar com o cliente.
BUSINESS_NAME=

# Transcrição de áudio inbound (Whisper via OpenAI). Sem ela, áudio não vira texto.
OPENAI_API_KEY=

# ============================================================
# uazapi (WhatsApp)
# ============================================================
# Em servidores dedicados use o host fornecido pela uazapi.
UAZAPI_BASE_URL=https://api.uazapi.com

# Admin token do servidor — cria/lista instâncias via /instance/init. Header: AdminToken
UAZAPI_ADMIN_TOKEN=

# Token de instância (fallback). Por instância criada via UI, o token é salvo
# criptografado em connections.access_token_encrypted e este vira fallback.
UAZAPI_TOKEN=
SYSTEM_WHATSAPP_INSTANCE_ID=

# Webhook secret para validar a origem uazapi
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# ============================================================
# Storage de mídia — Cloudflare R2 (recomendado) ou local
# ============================================================
# Setar todas as 4 R2_* → usa R2. Vazio → fallback LOCAL_MEDIA_ROOT (./tmp/media).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_URL=

# Storage local (apenas se NÃO usar R2)
LOCAL_MEDIA_ROOT=./tmp/media

# ============================================================
# Notificações de falha de API (opcional)
# ============================================================
ADMIN_WHATSAPP_NUMBER=5511999999999
ATTENDANT_NOTIFY_ON_FAILURE=false

# ── Cron ──────────────────────────────────────────────────────────────────
# Segredo do Cron Trigger. A rota /api/cron/tick e o unico despertador de tudo
# que e agendado quando nao ha Redis: escalacao de pipeline, mensagens
# agendadas, follow-ups, steps de automacao e lembretes.
# Sem esta variavel a rota responde 404 e NADA agendado dispara.
# Gere com `openssl rand -hex 32` e publique com `wrangler secret put CRON_SECRET`.
CRON_SECRET=

# ── WhatsApp OFICIAL (Cloud API da Meta) ─────────────────────────────────
# Opcional: só quem usa o canal oficial precisa. A conexão em si (número e
# token) NAO vem daqui — ela é cadastrada no banco por
# `npx tsx scripts/connect-cloud-api.ts`, com o token criptografado.
#
# Token que você digita no painel da Meta ao cadastrar o webhook. A Meta o
# devolve no GET de verificação; sem ele a verificação do endpoint falha.
META_VERIFY_TOKEN=
# App Secret do app da Meta. Assina cada POST (x-hub-signature-256). SEM ELE O
# WEBHOOK ACEITA QUALQUER PAYLOAD — qualquer um consegue injetar mensagem.
META_APP_SECRET=
# Versão da Graph API. A Meta descontinua versões antigas; ajuste quando sair aviso.
META_GRAPH_VERSION=v23.0

# ============================================================
# Evolution API (WhatsApp não-oficial, servidor PRÓPRIO do cliente)
# ============================================================
# Só para deploys que têm servidor Evolution. Vazio = a tela de Conexões nem
# oferece a opção e tudo segue pela uazapi.
#
# A key GLOBAL só é usada para CRIAR instância; o que fica guardado (cifrado)
# é a key de cada instância, que só opera aquele número.
EVOLUTION_URL=
EVOLUTION_GLOBAL_API_KEY=

# ============================================================
# E-mail (Gmail via OAuth) — opcional
# ============================================================
# Vazio = a tela de e-mail avisa que não está habilitado e não mostra o botão.
# Criar em console.cloud.google.com → APIs e Serviços → Credenciais →
# ID do cliente OAuth (tipo: Aplicativo da Web).
# URI de redirecionamento autorizado:
#   https://SEU-DOMINIO/api/email/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
